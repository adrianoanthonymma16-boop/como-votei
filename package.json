{
  "name": "como-votei",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma migrate deploy || true) && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "sync:camara": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync-camara.ts",
    "backfill:status": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/backfill-status-proposicoes.ts",
    "sync:senado": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync-senado.ts",
    "sync:despesas-camara": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync-despesas-camara.ts --apenas-despesas",
    "sync:despesas-senado": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync-despesas-senado.ts --apenas-despesas",
    "sync:emendas": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync-emendas.ts --apenas-emendas",
    "coverage": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/coverage.ts",
    "gc": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/gc.ts",
    "gc:apply": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/gc.ts --apply",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "@types/yauzl": "^3.4.0",
    "clsx": "^2.1.0",
    "next": "14.2.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stream-json": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "yauzl": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "prisma": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}

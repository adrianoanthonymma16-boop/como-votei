# Database (PostgreSQL - Neon/Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/como_votei?schema=public"

# Cron Secret (generate with: openssl rand -hex 32)
CRON_SECRET="your-cron-secret-here"

# App
NEXT_PUBLIC_APP_URL="https://como-votei.vercel.app"

# API Bases (constants, not secrets)
CAMARA_API_BASE="https://dadosabertos.camara.leg.br/api/v2"
SENADO_API_BASE="https://legis.senado.leg.br/dadosabertos"

# GitHub (para Vercel Cron disparar Actions)
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
GITHUB_REPOSITORY="owner/repo-name"